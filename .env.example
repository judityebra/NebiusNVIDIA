# Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Run `python scripts/check_models.py` and copy exact ids from its output.
NEBIUS_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Force offline mode even with a key set: SAFEFLOOR_MOCK=1
# Video analysis mode; only per_frame (one vision call per sampled frame) is implemented.
# SAFEFLOOR_VISION_MODE=per_frame
# Optional: regulation lookup for incident reports (https://tavily.com). Never commit a real key.
TAVILY_API_KEY=
# Optional: POST critical alerts (JSON) to this URL. Read from the environment only.
# SAFEFLOOR_WEBHOOK_URL=
